task.spawn(function()
    while Screen.Parent do
        if State.DoorBypass then
            for _, d in ipairs(State.DoorList) do
                pcall(function()
                    if d:IsA("BasePart") then
                        d.CanCollide = false
                    end
                    for _, c in ipairs(d:GetDescendants()) do
                        if c:IsA("BasePart") then c.CanCollide = false end
                        if c:IsA("ProximityPrompt") then
                            c.Enabled = true
                            c.HoldDuration = 0
                            c.MaxActivationDistance = 30
                        end
                    end
                end)
            end
        end
        task.wait(0.35)
    end
end)

local function tryFireDoorRemotes()
    for _, rem in ipairs(game:GetDescendants()) do
        if rem:IsA("RemoteEvent") or rem:IsA("RemoteFunction") then
            local n = string.lower(rem.Name)
            if string.find(n, "door") or string.find(n, "unlock") or string.find(n, "open") or string.find(n, "gate") then
                pcall(function()
                    if rem:IsA("RemoteEvent") then
                        rem:FireServer()
                        rem:FireServer(true)
                        rem:FireServer("Open")
                    end
                end)
            end
        end
    end
end

task.defer(function()
    task.wait(1)
    refreshLists()
    tryFireDoorRemotes()
end)

